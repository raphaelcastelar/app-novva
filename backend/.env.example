PORT=8080
DATABASE_URL=postgresql://novva:novva_local@localhost:5432/novva
JWT_SECRET=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
APP_ORIGIN=*
NODE_ENV=development
RESET_TOKEN_MINUTES=30
PASSWORD_RESET_URL=https://app.novva.example/redefinir-senha
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Novva <nao-responda@novva.example>
S3_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
PUSH_NOTIFICATIONS_ENABLED=false
# Preferencial: JSON da conta de serviço do Firebase codificado em base64.
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Alternativa ao JSON em base64:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
SERPRO_ENABLED=false
SERPRO_CONSUMER_KEY=
SERPRO_CONSUMER_SECRET=
SERPRO_CONTRACTOR_CNPJ=
# Use diretamente o arquivo PFX/P12 ou, alternativamente, o certificado e a chave PEM.
SERPRO_PFX_PATH=
SERPRO_CERT_PEM=
SERPRO_PRIVATE_KEY_PEM=
SERPRO_CERT_PATH=
SERPRO_PRIVATE_KEY_PATH=
SERPRO_CERT_PASSWORD=
SERPRO_AUTH_URL=https://autenticacao.sapi.serpro.gov.br/authenticate
SERPRO_GATEWAY_URL=https://gateway.apiserpro.serpro.gov.br/integra-contador/v1
# Em produção, configure APP_ORIGIN com os domínios permitidos e um JWT_SECRET aleatório.
