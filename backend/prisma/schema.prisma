generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum DocumentStatus {
  PENDING
  SENT
  REVIEW
  APPROVED
  REJECTED
}

enum ObligationStatus {
  OPEN
  DUE_SOON
  OVERDUE
  PAID
  CANCELED
}

enum InvoiceStatus {
  REQUESTED
  PROCESSING
  ISSUED
  REJECTED
  CANCELED
}

enum PaymentStatus {
  OPEN
  PAID
  OVERDUE
  CANCELED
}

enum MessageSender {
  USER
  ACCOUNTANT
  SYSTEM
}

enum RequestKind {
  DOCUMENT
  INVOICE
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  cpf                 String               @unique @db.VarChar(11)
  name                String               @db.VarChar(160)
  email               String               @unique @db.VarChar(254)
  phone               String?              @db.VarChar(20)
  passwordHash        String?              @map("password_hash")
  status              UserStatus           @default(ACTIVE)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  profile             MedicalProfile?
  cnpjs               Cnpj[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  documents           Document[]
  obligations         Obligation[]
  invoices            Invoice[]
  payments            Payment[]
  conversation        Conversation?
  notifications       Notification[]
  auditLogs           AuditLog[]

  @@map("users")
}

model MedicalProfile {
  userId      String   @id @map("user_id") @db.Uuid
  crm         String?  @db.VarChar(40)
  specialty   String?  @db.VarChar(100)
  taxRegime   String?  @map("tax_regime") @db.VarChar(80)
  companyName String?  @map("company_name") @db.VarChar(180)
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("medical_profiles")
}

model Cnpj {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  nickname    String   @db.VarChar(100)
  cnpj        String   @db.VarChar(14)
  companyName String?  @map("company_name") @db.VarChar(180)
  active      Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cnpj])
  @@index([userId])
  @@map("cnpjs")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Document {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  title           String         @db.VarChar(160)
  category        String         @db.VarChar(100)
  description     String?
  status          DocumentStatus @default(PENDING)
  month           Int?
  year            Int?
  rejectionReason String?        @map("rejection_reason")
  fileKey         String?        @map("file_key")
  mimeType        String?        @map("mime_type") @db.VarChar(100)
  originalName    String?        @map("original_name") @db.VarChar(255)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("documents")
}

model Obligation {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  name        String           @db.VarChar(160)
  kind        String           @db.VarChar(40)
  dueDate     DateTime         @map("due_date") @db.Date
  amount      Decimal          @db.Decimal(12, 2)
  status      ObligationStatus @default(OPEN)
  paymentCode String?          @map("payment_code")
  pdfKey      String?          @map("pdf_key")
  paidAt      DateTime?        @map("paid_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueDate(sort: Desc)])
  @@map("obligations")
}

model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  takerCnpj       String        @map("taker_cnpj") @db.VarChar(14)
  municipality    String        @db.VarChar(120)
  serviceDate     DateTime      @map("service_date") @db.Date
  amount          Decimal       @db.Decimal(12, 2)
  taxationCode    String        @map("taxation_code") @db.VarChar(30)
  description     String
  issueTime       String?       @map("issue_time") @db.VarChar(5)
  status          InvoiceStatus @default(REQUESTED)
  pdfKey          String?       @map("pdf_key")
  rejectionReason String?       @map("rejection_reason")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("invoices")
}

model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  description String        @db.VarChar(180)
  kind        String        @db.VarChar(30)
  amount      Decimal       @db.Decimal(12, 2)
  dueDate     DateTime      @map("due_date") @db.Date
  status      PaymentStatus @default(OPEN)
  pixCode     String?       @map("pix_code")
  boletoCode  String?       @map("boleto_code")
  paidAt      DateTime?     @map("paid_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueDate(sort: Desc)])
  @@map("payments")
}

model Conversation {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @unique @map("user_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@map("conversations")
}

model Message {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @map("conversation_id") @db.Uuid
  sender         MessageSender
  body           String
  readAt         DateTime?     @map("read_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  title     String    @db.VarChar(160)
  body      String
  kind      String    @default("general") @db.VarChar(30)
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String   @db.VarChar(80)
  entity    String   @db.VarChar(80)
  entityId  String?  @map("entity_id") @db.VarChar(80)
  ip        String?  @db.VarChar(64)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model RequestEvent {
  id          String      @id @default(uuid()) @db.Uuid
  requestKind RequestKind @map("request_kind")
  requestId   String      @map("request_id") @db.Uuid
  status      String      @db.VarChar(30)
  note        String?
  actor       String?     @db.VarChar(160)
  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([requestKind, requestId, createdAt])
  @@map("request_events")
}
